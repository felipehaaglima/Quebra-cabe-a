# Server-only. Configure separately in local/preview/production.
# Copy to .env.local and replace these placeholders. Do not commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon key, never service_role.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional canonical origin for CSRF validation; omit for dynamic preview origins.
# APP_ORIGIN=https://your-site.example
